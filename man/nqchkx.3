.\" SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
.Dd October 29, 2026
.Dt NQCHKX 3
.Os
.Sh NAME
.Nm nqchkx
.Nd check a capsule, partially or with its inputs
.Sh LIBRARY
libnoqtis, \-lnoqtis
.Sh SYNOPSIS
.In noqtis.h
.Bd -literal
typedef struct {
  const uint8_t *trust;
  size_t trustlen;
  const uint8_t *const *anc;
  const size_t *anclen;
  size_t nanc;
  const char *const *only;
  size_t nonly;
  const char *const *lin;
  size_t nlin;
  const char *const *stmt;
  const size_t *stmtlen;
  size_t nstmt;
} nqcopt;
.Ed
.Pp
.Ft int
.Fn nqchkx "const char *dir" "const nqcopt *o" "nqrep **rep"
.Sh DESCRIPTION
.Fn nqchkx
is
.Xr nqchkt 3
with the options in
.Fa o ;
any member may be 0 or
.Dv NULL ,
and
.Fa o
itself may be
.Dv NULL .
.Fa trust ,
.Fa anc ,
.Fa anclen
and
.Fa nanc
are as for
.Xr nqchkt 3 .
.Pp
.Fa only Ns Bq 0..nonly
makes the check partial: the seal, the signature and the manifest are
checked in full, but only these listed paths are checked as files; the
others are neither read nor needed, and files present but not listed are
not looked for.
.Ql partial
rows say what was left out.
A path the manifest does not list fails its
.Ql file
row.
.Pp
.Fa lin Ns Bq 0..nlin
are folders of capsules that may be the inputs of a format 2 capsule
.Pq Xr nqseal2 3 .
Each input is found among them by its id
.Pq Xr nqcapid 3
(the SHA-256 of its manifest, or of its manifest's head for format 2,
as its seal records it) and checked in full with no key pinned, no
statements and no
.Fa only ,
but with the same anchors and folders, its own inputs in turn, to 64
levels; one
.Ql lineage
row per input says whether it was found and checks, and for one that does
not check, its first failing row.
.Pp
.Fa stmt Ns Bq 0..nstmt
are key statements of
.Fa stmtlen Ns Bq i
bytes, at most 32, from
.Xr nqkstmt 3 ;
they need
.Fa trust
.Pq Er NQEARG No otherwise .
One
.Ql keys
row per statement.
The
.Ql key
row then also passes for a key the trusted key was rotated to, through
the statements, and a
.Ql key.time
row requires a verified timestamp from before the seal's key was rotated
away or revoked, when it was.
For a key with an
.Ql expire
statement
.Pq Xr nqkexp 3
no timestamp is asked for until the time it names, judged by
.Ev SOURCE_DATE_EPOCH
when set and else by the clock; from then on, as for a revocation.
.Sh RETURN VALUES
As
.Xr nqchk 3 :
.Dv NQOK
when every check passed,
.Er NQEVRFY
when one failed (the report says which),
.Er NQEARG ,
.Er NQELIM
and
.Er NQEMEM
with no report.
.Er NQEARG
is also returned for
.Fa nonly ,
.Fa nlin
or
.Fa nstmt
not 0 with its array
.Dv NULL ,
a
.Dv NULL
statement, and statements without
.Fa trust ;
.Er NQELIM
for more than 32 anchors, 2,000,000 paths in
.Fa only ,
1024 lineage folders or 32 statements.
.Sh EXAMPLES
Check two files of a large capsule, with its key pinned:
.Bd -literal -offset indent
static const char *const want[] = {"data/a.csv", "data/b.csv"};
nqcopt o = {0};
nqrep *rep = NULL;
int rc;
o.trust = pk;
o.trustlen = pklen;
o.only = want;
o.nonly = 2;
rc = nqchkx("results", &o, &rep);
nqrepfree(rep);
.Ed
.Sh SEE ALSO
.Xr noqtis-check 1 ,
.Xr nqchk 3 ,
.Xr nqchkt 3 ,
.Xr nqkstmt 3 ,
.Xr nqprove 3 ,
.Xr nqrep 3 ,
.Xr nqseal2 3 ,
.Xr noqtis-capsule 5
