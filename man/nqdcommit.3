.\" SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
.Dd November 15, 2026
.Dt NQDCOMMIT 3
.Os
.Sh NAME
.Nm nqdcommit ,
.Nm nqdreveal ,
.Nm nqdcite
.Nd commitments and citations of a data record
.Sh LIBRARY
libnqd, \-lnqd \-lnoqtis
.Sh SYNOPSIS
.In nqd.h
.Ft int
.Fo nqdcommit
.Fa "const uint8_t *salt" "size_t sl" "const uint8_t *m" "size_t n"
.Fa "char hex[65]"
.Fc
.Ft int
.Fo nqdreveal
.Fa "const nqdrec *r" "const uint8_t *salt" "size_t sl"
.Fa "const uint8_t *m" "size_t n" "size_t *idx"
.Fc
.Ft int
.Fo nqdcite
.Fa "const nqdrec *r" "int fmt" "char *out" "size_t cap" "size_t *outlen"
.Fc
.Sh DESCRIPTION
.Fn nqdcommit
writes to
.Fa hex
the 64 lower-case hex digits (and a NUL) of the commitment to the
.Fa n
bytes at
.Fa m
under the secret
.Fa salt
of
.Fa sl
bytes, 16 to 1,024 (take 32 from
.Xr nqrand 3 ) :
SHA3-256 of the string
.Ql noqtis-commit-1
with its NUL, the salt's length as 8 bytes big-endian, the salt and
the bytes.
In symbols, with BE64 an 8-byte big-endian integer and
.Sy ||
concatenation:
.Bd -literal -offset indent
c = SHA3-256("noqtis-commit-1" || 0x00 || BE64(|salt|) || salt || m)
.Ed
.Pp
the tag being 15 bytes and its NUL one.
The tag keeps the digest from passing for any other digest noqtis
makes; the length fixes where the salt ends.
Put it in a
.Ql commits
element with
.Xr nqdput 3 .
.Pp
.Fn nqdreveal
computes the same over
.Fa m
and
.Fa salt
and compares it with every
.Ql commits
digest of
.Fa r ,
each in constant time; on a match
.Fa *idx
(when not
.Dv NULL )
gets the element's index.
.Pp
.Fn nqdcite
writes the record's
.Ql cite
as a
.Pa CITATION.cff
1.2.0
.Pq Dv NQDCFF
or a BibTeX entry
.Pq Dv NQDBIB
to
.Fa out ,
as
.Xr nqdjson 3
writes.
.Sh RETURN VALUES
.Dv NQOK ;
.Fn nqdreveal :
.Dv NQEVRFY
when no commitment matches;
.Fn nqdcite :
.Dv NQEIO
when there is no
.Ql cite ,
.Dv NQEDEC
for one that is not of the format (not an object, or no title; a record
from
.Xr nqdload 3
never holds one),
.Dv NQEBUF
for a
.Fa cap
too small;
.Dv NQEARG
for a salt out of bounds or an unknown format.
.Sh EXAMPLES
Commit to a randomisation list before the data are seen:
.Bd -literal -offset indent
uint8_t salt[32];
char hex[65];
int rc = nqrand(salt, sizeof salt);
if (rc == NQOK)
  rc = nqdcommit(salt, sizeof salt, list, listlen, hex);
/* keep salt secret; hex is the "digest" of a "commits" element,
   which also needs its alg, created and kind (noqtis-data(5)) */
.Ed
.Sh SEE ALSO
.Xr noqtis-cite 1 ,
.Xr noqtis-commit 1 ,
.Xr noqtis-reveal 1 ,
.Xr nqdnew 3 ,
.Xr noqtis-data 5
.Sh STANDARDS
.Rs
.%T FIPS 202: SHA-3 Standard: Permutation-Based Hash and Extendable-Output Functions
.%Q NIST
.%D August 2015
.Re
