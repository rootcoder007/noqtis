.\" SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
.Dd October 30, 2026
.Dt NQDSSE 3
.Os
.Sh NAME
.Nm nqdsse ,
.Nm nqdssevrfy
.Nd sign and check DSSE envelopes
.Sh LIBRARY
libnoqtis, \-lnoqtis
.Sh SYNOPSIS
.In noqtis.h
.Ft int
.Fo nqdsse
.Fa "nqsalg alg" "const uint8_t *sk" "size_t sklen"
.Fa "const uint8_t *pk" "size_t pklen" "const char *type"
.Fa "const uint8_t *payload" "size_t n"
.Fa "char *out" "size_t cap" "size_t *outlen"
.Fc
.Ft int
.Fo nqdssevrfy
.Fa "nqsalg alg" "const uint8_t *pk" "size_t pklen"
.Fa "const char *env" "size_t n"
.Fa "uint8_t *payload" "size_t cap" "size_t *outlen" "char type[256]"
.Fc
.Sh DESCRIPTION
.Fn nqdsse
writes to
.Fa out ,
of
.Fa cap
bytes, a DSSE envelope of the
.Fa n
payload bytes, signed with the key pair
.Fa sk , pk
of
.Fa alg
over the envelope's pre-authentication encoding
.Bd -literal -offset indent
"DSSEv1" SP LEN(type) SP type SP LEN(payload) SP payload
.Ed
.Pp
(lengths in ASCII decimal, SP one space), signed by
.Xr nqsign 3
with no context, pure and hedged, and written as canonical JSON:
.Bd -literal -offset indent
{"payload":<base64>,"payloadType":<type>,
 "signatures":[{"keyid":<hex SHA-256 of pk>,"sig":<base64>}]}
.Ed
.Pp
.Fa type
is 1 to 255 printable ASCII bytes with no space, quote or backslash,
such as
.Ql application/vnd.in-toto+json .
Base64 is the padded standard alphabet of RFC 4648 section 4.
Any signature algorithm of noqtis may sign, Ed25519 alone included.
The signature is checked before the envelope is written.
.Fa *outlen
gets the envelope's size, also when
.Fa cap
is too small.
.Pp
.Fn nqdssevrfy
checks the envelope
.Fa env
of
.Fa n
bytes: one of its signatures (at most 16) must verify under
.Fa pk
over the pre-authentication encoding of its
.Ql payloadType
and decoded
.Ql payload .
The envelope need not be canonical, and other members are ignored, as
is each signature's
.Ql keyid ;
a signature entry that is not an object or whose
.Ql sig
does not decode is skipped.
Only the padded standard base64 alphabet is read: the URL-safe or
unpadded encodings that the DSSE specification also allows give
.Er NQEDEC
(for the payload) or a skipped signature.
The payload then goes to
.Fa payload
.Pf ( Fa *outlen
its size, also when
.Fa cap
is too small) and, when
.Fa type
is not
.Dv NULL ,
the payload type to it, NUL-terminated.
.Sh RETURN VALUES
.Bl -tag -width NQEVRFY
.It Dv NQOK
Written, or checked.
.It Bq Er NQEBUF
.Fa cap
is too small.
.It Bq Er NQEVRFY
.Fn nqdssevrfy :
no signature verifies.
.It Bq Er NQEDEC
.Fn nqdssevrfy :
not an envelope: not JSON, no string
.Ql payload
or allowed
.Ql payloadType ,
or a
.Ql signatures
array of none or more than 16.
.It Bq Er NQEARG
A
.Dv NULL
argument, keys of the wrong size or not a pair, or a type that is not
allowed.
.It Bq Er NQEMEM
The allocation hook returned
.Dv NULL .
.It Bq Er NQERNG , NQEFLT
.Fn nqdsse :
as
.Xr nqsign 3 .
.El
.Sh EXAMPLES
Wrap an in-toto statement and read it back:
.Bd -literal -offset indent
static char env[65536];
static uint8_t back[16384];
char type[256];
size_t n, m;
int rc = nqdsse(NQMLDSA65, sk, sklen, pk, pklen,
                "application/vnd.in-toto+json", stmt, stmtlen,
                env, sizeof env, &n);
if (rc == NQOK)
  rc = nqdssevrfy(NQMLDSA65, pk, pklen, env, n, back, sizeof back, &m,
                  type);
.Ed
.Sh SEE ALSO
.Xr noqtis-export 1 ,
.Xr noqtis-verify 1 ,
.Xr nqsign 3
.Sh STANDARDS
.Rs
.%T DSSE: Dead Simple Signing Envelope
.%U https://github.com/secure-systems-lab/dsse/blob/master/envelope.md
.Re
.Rs
.%T DSSE protocol
.%U https://github.com/secure-systems-lab/dsse/blob/master/protocol.md
.Re
.Rs
.%A S. Josefsson
.%T The Base16, Base32, and Base64 Data Encodings
.%R RFC 4648
.%D October 2006
.Re
