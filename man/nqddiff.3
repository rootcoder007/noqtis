.\" SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
.Dd November 15, 2026
.Dt NQDDIFF 3
.Os
.Sh NAME
.Nm nqddiff
.Nd what changed between two capsules
.Sh LIBRARY
libnqd, \-lnqd \-lnoqtis
.Sh SYNOPSIS
.In nqd.h
.Ft int
.Fn nqddiff "const char *a" "const char *b" "nqdrep **rep"
.Sh DESCRIPTION
.Fn nqddiff
compares the capsule in folder
.Fa a
with the one in
.Fa b
and reports, as
.Xr nqdchk 3
does, one failed row per difference: a
.Ql manifest
row (passed) with the file counts, or saying a folder is not sealed;
.Ql file
rows for files added, removed or changed between the manifests (read
with
.Xr nqfiles 3 ) ;
and rows named
.Ql source ,
.Ql schema ,
.Ql stats ,
.Ql check ,
.Ql env ,
.Ql cite ,
.Ql steps
and
.Ql commits
for the differences of the data records, as
.Xr noqtis-diff 1
describes.
Nothing is checked.
.Sh RETURN VALUES
.Dv NQOK
when nothing differs,
.Dv NQEVRFY
when something does,
.Dv NQEDEC
when the two cannot be compared (a seal, manifest or data record that is
there but does not read, or neither a seal nor a record in either),
with a failed row that says why, with
.Fa *rep
set in all three cases;
.Dv NQEARG
or
.Dv NQEMEM
without a report.
.Sh EXAMPLES
.Bd -literal -offset indent
nqdrep *rep = NULL;
size_t i;
if (nqddiff("v1", "v2", &rep) == NQEVRFY)
  for (i = 0; i < nqdrepn(rep); i++) {
    const char *c, *d;
    int ok;
    if (nqdrepi(rep, i, &c, &ok, &d) == NQOK && !ok)
      printf("%s: %s\en", c, d);
  }
nqdrepfree(rep);
.Ed
.Sh SEE ALSO
.Xr noqtis-diff 1 ,
.Xr nqdchk 3 ,
.Xr nqfiles 3 ,
.Xr noqtis-data 5
