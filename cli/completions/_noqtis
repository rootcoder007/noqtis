#compdef noqtis
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# zsh completion for noqtis(1).

local -a algs hashes
algs=(ML-DSA-44 ML-DSA-65 ML-DSA-87 SLH-DSA-SHA2-128s SLH-DSA-SHA2-128f
  SLH-DSA-SHA2-192s SLH-DSA-SHA2-192f SLH-DSA-SHA2-256s SLH-DSA-SHA2-256f
  SLH-DSA-SHAKE-128s SLH-DSA-SHAKE-128f SLH-DSA-SHAKE-192s
  SLH-DSA-SHAKE-192f SLH-DSA-SHAKE-256s SLH-DSA-SHAKE-256f Ed25519
  ML-DSA-44+Ed25519 ML-DSA-65+Ed25519 ML-DSA-87+Ed25519 ML-KEM-512
  ML-KEM-768 ML-KEM-1024 HQC-128 HQC-192 HQC-256)
hashes=(sha224 sha256 sha384 sha512 sha512-224 sha512-256 sha3-224 sha3-256
  sha3-384 sha3-512 shake128 shake256)

_noqtis_cmd() {
  case $words[1] in
    keygen)
      _arguments \
        '(-a --alg)'{-a,--alg=}'[algorithm]:algorithm:($algs)' \
        '(-o --out)'{-o,--out=}'[key file to write]:key:_files' \
        '--seed[seed as hex or a seed file]:seed:_files' \
        '(-f --force)'{-f,--force}'[replace existing files]' ;;
    sign)
      _arguments \
        '(-k --key)'{-k,--key=}'[secret key]:key:_files' \
        '(-o --out)'{-o,--out=}'[signature file]:sig:_files' \
        '(-c --ctx)'{-c,--ctx=}'[context string]:ctx:' \
        '(-d --det)'{-d,--det}'[deterministic signature]' \
        '--ph[pre-hash with]:hash:($hashes)' \
        '(-f --force)'{-f,--force}'[replace an existing signature]' \
        ':file:_files' ;;
    verify)
      _arguments \
        '(-p --pub)'{-p,--pub=}'[public key]:key.pub:_files' \
        '(-s --sig)'{-s,--sig=}'[signature]:sig:_files' \
        '(-c --ctx)'{-c,--ctx=}'[context string]:ctx:' \
        '--ph[pre-hash with]:hash:($hashes)' \
        '(-q --quiet)'{-q,--quiet}'[print nothing]' \
        ':file:_files' ;;
    enc)
      _arguments \
        '(-p --pub)'{-p,--pub=}'[public key]:key.pub:_files' \
        '(-o --out)'{-o,--out=}'[ciphertext file]:ct:_files' \
        '--stdout[print the shared secret]' \
        '(-f --force)'{-f,--force}'[replace existing files]' \
        '::ss:_files' ;;
    dec)
      _arguments \
        '(-k --key)'{-k,--key=}'[secret key]:key:_files' \
        '(-o --out)'{-o,--out=}'[shared secret file]:ss:_files' \
        '--stdout[print the shared secret]' \
        '(-f --force)'{-f,--force}'[replace an existing file]' \
        ':ct:_files' ;;
    hash)
      _arguments \
        '(-a --alg)'{-a,--alg=}'[hash]:hash:($hashes)' \
        '(-c --check)'{-c,--check}'[check a list of sums]' \
        '*:file:_files' ;;
    seal)
      _arguments \
        '(-k --key)'{-k,--key=}'[secret key]:key:_files' \
        '(-p --pub)'{-p,--pub=}'[public key to check against]:key.pub:_files' \
        '(-m --meta)'{-m,--meta=}'[metadata JSON]:json-file:_files' \
        '--format=[capsule format]:format:(1 2)' \
        '*--input=[an input capsule]:dir:_files -/' \
        '*--tsa[RFC 3161 timestamp authority]:url:_urls' \
        '*--anchor[trusted root certificate]:der-file:_files' \
        ':dir:_files -/' ;;
    check)
      _arguments \
        '(-p --pub)'{-p,--pub=}'[expected public key]:key.pub:_files' \
        '(-j --json)'{-j,--json}'[JSON report]' \
        '*--anchor[trusted root certificate]:der-file:_files' \
        '*--only=[check only this file]:path:_files' \
        '*--lineage=[an input capsule folder]:dir:_files -/' \
        '--proof=[a proof from noqtis prove]:file:_files' \
        '*--keys=[a key statement]:file:_files' \
        '--card=[an identity card from noqtis idcard]:file:_files' \
        ':dir:_files -/' ;;
    idcard)
      _arguments \
        '(-k --key)'{-k,--key=}'[secret key]:key:_files' \
        '(-p --pub)'{-p,--pub=}'[its public key]:key.pub:_files' \
        '--name=[your name]:name:' \
        '--orcid=[your ORCID iD]:id:' \
        '--email=[your e-mail address]:address:' \
        '--url=[your web page, https://]:url:_urls' \
        '--affil=[your affiliation]:text:' \
        '(-o --out)'{-o,--out=}'[file to write]:file:_files' \
        '(-f --force)'{-f,--force}'[replace the file]' \
        '--verify=[check a card]:card:_files' ;;
    export)
      _arguments \
        '--as=[format]:format:(intoto dsse rocrate bagit bundle)' \
        '(-k --key)'{-k,--key=}'[secret key (dsse)]:key:_files' \
        '(-p --pub)'{-p,--pub=}'[its public key]:key.pub:_files' \
        '(-o --out)'{-o,--out=}'[file or bag folder to write]:file:_files' \
        '(-f --force)'{-f,--force}'[replace the file]' \
        '--no-files[a bundle of the data record alone]' \
        ':dir:_files -/' ;;
    pack)
      _arguments \
        '1:action:(init build check unpack)' \
        '(-t --template)'{-t,--template=}'[the template]:name:(plain r python)' \
        '(-k --key)'{-k,--key=}'[secret key]:key:_files' \
        '(-p --pub)'{-p,--pub=}'[its public key]:key.pub:_files' \
        '--format=[capsule format]:format:(1 2)' \
        '*--lock=[a lock file]:file:_files' \
        '(-o --out)'{-o,--out=}'[the bundle file]:file:_files' \
        '(-f --force)'{-f,--force}'[replace the file]' \
        '--no-files[a bundle of the data record alone]' \
        '*:path:_files' ;;
    chunk)
      _arguments \
        '1:action:(pin check)' \
        '--size=[bytes in a chunk]:bytes:' \
        '--at=[where the piece starts]:offset:' \
        '(-j --json)'{-j,--json}'[JSON output]' \
        '*:path:_files' ;;
    chain)
      _arguments \
        '(-p --pub)'{-p,--pub=}'[the key of every link]:key.pub:_files' \
        '*--anchor[trusted root certificate]:der-file:_files' \
        '(-j --json)'{-j,--json}'[JSON output]' \
        '*:dir:_files -/' ;;
    rotate|revoke)
      _arguments \
        '(-k --key)'{-k,--key=}'[secret key]:key:_files' \
        '(-p --pub)'{-p,--pub=}'[its public key]:key.pub:_files' \
        '(-n --new)'{-n,--new=}'[the new secret key (rotate)]:key:_files' \
        '--new-pub=[the new public key (rotate)]:key.pub:_files' \
        '--at=[when, YYYY-MM-DDTHH:MM:SSZ]:time:' \
        '--reason=[why]:text:' \
        '(-o --out)'{-o,--out=}'[file to write]:file:_files' \
        '(-f --force)'{-f,--force}'[replace the file]' ;;
    prove)
      _arguments \
        '(-p --pub)'{-p,--pub=}'[expected public key]:key.pub:_files' \
        '(-o --out)'{-o,--out=}'[file to write]:file:_files' \
        '(-f --force)'{-f,--force}'[replace the file]' \
        ':dir:_files -/' '*:path:_files' ;;
    inspect)
      _arguments '(-j --json)'{-j,--json}'[JSON report]' ':dir:_files -/' ;;
    timestamp)
      _arguments \
        '*--tsa[RFC 3161 timestamp authority]:url:_urls' \
        '*--anchor[trusted root certificate]:der-file:_files' \
        '--force[replace an existing timestamp]' \
        ':dir:_files -/' ;;
    data)
      _arguments \
        '1:action:(init add put del fmt show check syn)' \
        '(-f --force)'{-f,--force}'[replace the record (init)]' \
        '(-u --url)'{-u,--url=}'[where the file came from]:url:_urls' \
        '--title=[its title]:text:' \
        '--publisher=[its publisher]:text:' \
        '--licence=[its licence]:text:' \
        '--retrieved=[when, YYYY-MM-DDTHH:MM:SSZ or now]:time:' \
        '--etag=[the server'"'"'s ETag]:text:' \
        '--modified=[the server'"'"'s Last-Modified]:text:' \
        '--archived=[an archived copy]:url:_urls' \
        '*--mirror=[another URL with the same bytes]:url:_urls' \
        '--synthetic[a generated stand-in]' \
        '(-j --json)'{-j,--json}'[JSON output]' \
        '--seed=[the seed of a synthetic file (syn)]:n:' \
        '--rows=[its rows (syn)]:n:' \
        '*:path:_files' ;;
    env)
      _arguments '--rng=[the random number generator]:kind:' \
        '--seed=[its seed]:seed:' '*--lock=[a lock file]:file:_files' \
        ':dir:_files -/' ;;
    commit)
      _arguments \
        '--kind=[what the file is]:kind:(randomisation preregistration other)' \
        '--label=[a short name]:text:' '--after=[not before, UTC]:time:' \
        '(-o --out)'{-o,--out=}'[the salt file]:file:_files' \
        '(-f --force)'{-f,--force}'[replace the salt file]' \
        ':dir:_files -/' ':file:_files' ;;
    reveal)
      _arguments ':dir:_files -/' ':file:_files' ':salt:_files' ;;
    cite)
      _arguments '--format=[the format]:format:(cff bibtex)' ':dir:_files -/' ;;
    src)
      _arguments \
        '1:action:(add resolve fetch refresh list)' \
        '(-u --url)'{-u,--url=}'[the address of the file]:url:' \
        '--portal=[the portal]:portal:(ckan socrata arcgis)' \
        '--base=[the portal address]:url:' '--id=[the dataset]:id:' \
        '--resource=[the resource]:id:' '--format=[the format]:format:' \
        '--layer=[the layer]:n:' '*--mirror=[a copy]:url:' \
        '--archived=[an archived copy]:url:' \
        '--wayback[pin the Wayback Machine copy]' \
        '--synthetic[a generated stand-in]' \
        '--max=[the largest file]:bytes:' '--timeout=[seconds per file]:s:' \
        '(-j --json)'{-j,--json}'[JSON output]' \
        '(-w --write)'{-w,--write}'[record what changed]' \
        '(-f --force)'{-f,--force}'[replace a file that differs]' \
        '*:path:_files' ;;
    drift)
      _arguments \
        '1:action:(pin check cal)' \
        '(-d --delim)'{-d,--delim=}'[the delimiter]:c:' \
        '--no-header[the first line is data]' \
        '(-j --json)'{-j,--json}'[JSON output]' \
        '--psi-warn=[PSI that warns]:x:' \
        '--psi-fail=[PSI that fails]:x:' \
        '--alpha=[p-value that warns]:p:' \
        '--min-n=[values both need before PSI fails]:n:' \
        '--benford[Benford test warns too]' \
        '*:path:_files' ;;
    diff)
      _arguments '(-j --json)'{-j,--json}'[JSON output]' ':dir:_files -/' \
        ':dir:_files -/' ;;
    report)
      _arguments \
        '(-p --pub)'{-p,--pub=}'[the key the seal must carry]:pub-file:_files' \
        '(-f --format)'{-f,--format=}'[the report'"'"'s format]:format:(md txt)' \
        '(-o --out)'{-o,--out=}'[write the report to a file]:file:_files' \
        '(-j --json)'{-j,--json}'[a JSON summary instead]' \
        '--github[GitHub workflow annotations]' \
        ':dir:_files -/' ;;
    schema)
      _arguments \
        '1:action:(infer check)' \
        '(-d --delim)'{-d,--delim=}'[the delimiter]:c:' \
        '--no-header[the first line is data]' \
        '--ranges[pin number and date ranges]' \
        '--put[record the schema]' \
        '(-j --json)'{-j,--json}'[JSON output]' \
        '*:path:_files' ;;
    ers)
      _arguments \
        '*--tsa[RFC 3161 timestamp authority]:url:_urls' \
        '*--anchor[trusted root certificate]:der-file:_files' \
        '--hash[the new timestamp'"'"'s hash]:hash:(sha256 sha384 sha512)' \
        ':dir:_files -/' ;;
  esac
}

_arguments -C \
  '(- :)'{-V,--version}'[print the version]' \
  '1:command:((keygen\:"make a key pair" sign\:"sign a file"
    verify\:"verify a signature" enc\:"encapsulate a shared secret"
    dec\:"decapsulate a shared secret" hash\:"print or check digests"
    seal\:"seal a folder" check\:"check a sealed folder"
    prove\:"prove some files of a capsule"
    rotate\:"say a seal key was replaced" revoke\:"say a seal key is revoked"
    idcard\:"make or check an identity card"
    export\:"a capsule as in-toto, DSSE, RO-Crate, BagIt or a bundle"
    pack\:"start, build and check a reproducibility bundle"
    chunk\:"chunk digests of a large file, a piece checked"
    chain\:"check an append-only chain of capsules"
    inspect\:"show what a seal says" selftest\:"run the known-answer self-test" timestamp\:"add public timestamps" ers\:"start or renew an evidence record"
    data\:"make, show and check a data record"
    schema\:"pin and check the schema of CSV files"
    diff\:"what changed between two capsules"
    report\:"check a capsule and write a report of it"
    src\:"fetch the sources and say if they changed"
    drift\:"summarise CSV files and check them for drift"
    env\:"record the environment"
    commit\:"commit to a file, to reveal it later"
    reveal\:"check a file against a commitment"
    cite\:"print how to cite the data"
    algs\:"list the algorithms" version\:"print the version"))' \
  '*::arg:_noqtis_cmd'
