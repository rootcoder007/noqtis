// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Replaces Starlight's theme menu with the home page's sun button: it
// flips between dark and light and remembers the choice (see Theme.astro).
---

<button class="nq-theme" type="button" aria-label="Switch light or dark">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
</button>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>(".nq-theme")) {
    b.addEventListener("click", () => {
      const root = document.documentElement;
      root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
      try { localStorage.setItem("nqtheme", root.dataset.theme); } catch {}
    });
  }
</script>

<style>
  .nq-theme {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .nq-theme:hover,
  .nq-theme:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-5);
    outline: none;
  }
</style>
