</main>

<script type="application/json" id="nqdemos" set:html={JSON.stringify(demos)}></script>
<script is:inline>

const $ = (s, r = document) => r.querySelector(s);
function el(tag, attrs = {}, ...kids) { const e = document.createElement(tag); for (const [k, v] of Object.entries(attrs)) k === "on" ? e.addEventListener("click", v) : e.setAttribute(k, v); e.append(...kids); return e; }

/* theme: system by default; the button flips and remembers */
const root = document.documentElement;
try { const t = localStorage.getItem("nqtheme"); if (t) root.dataset.theme = t; } catch {}
$("#theme").addEventListener("click", () => {
  const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  root.dataset.theme = dark ? "light" : "dark";
  try { localStorage.setItem("nqtheme", root.dataset.theme); } catch {}
});

/* story terminal (pi.dev's demo controller): one sticky terminal shows the session of the
   active section: the last one whose title midline has crossed 70% of the terminal frame */
const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
const narrow = matchMedia("(max-width: 1023px)");
const wait = (ms) => new Promise((r) => setTimeout(r, ms));
function paint(line) {
  const f = document.createDocumentFragment();
  if (line.startsWith("$ ")) { f.append(el("span", { class: "dim" }, "$ "), el("span", { class: "c" }, line.slice(2))); return f; }
  const m = line.match(/^(ok|FAIL)(\s+.*)$/);
  if (m) { f.append(el("span", { class: m[1] === "ok" ? "ok" : "fail" }, m[1]), m[2]); return f; }
  if (/: OK \(/.test(line)) { f.append(el("span", { class: "ok" }, line)); return f; }
  if (/FAILED|^noqtis \w+: /.test(line)) { f.append(el("span", { class: "fail" }, line)); return f; }
  f.append(line); return f;
}
function makeFig() {
  const dot = el("span", { class: "dot" }), title = el("span", {}, "");
  const term = el("pre", { class: "term", "aria-label": "Recorded terminal session" });
  const frame = el("div", { class: "frame" }, term);
  const cap = el("figcaption", { class: "fig-cap" });
  return { bar: el("div", { class: "fig-bar" }, title, dot), title, dot, frame, term, cap };
}
/* the widest line fits the frame: font size from the frame width and the line length */
function fit(f, lines) {
  const cols = Math.max(40, ...lines.map((l) => l.length + 2));
  const w = f.frame.clientWidth - 32, h = f.frame.clientHeight - 28;
  const byW = w / (cols * 0.6), byH = h / (Math.min(lines.length, 34) * 1.5);
  f.term.style.setProperty("--tfs", Math.max(6.5, Math.min(13, byW, Math.max(byH, 8))).toFixed(2) + "px");
}
async function play(f, lines, token) {
  f.term.replaceChildren(); f.dot.classList.add("live");
  const cur = el("span", { class: "cur" });
  for (const line of lines) {
    if (token.stop) return;
    const row = el("div"); f.term.append(row);
    if (line.startsWith("$ ") && !reduce) {
      row.append(el("span", { class: "dim" }, "$ "));
      const c = el("span", { class: "c" }); row.append(c, cur);
      for (const ch of line.slice(2)) { if (token.stop) return; c.textContent += ch; await wait(22); }
      await wait(360); cur.remove();
    } else { row.append(paint(line)); if (!reduce) await wait(28); }
    f.term.scrollTop = f.term.scrollHeight;
  }
  if (token.stop) return;
  f.term.append(el("div", {}, el("span", { class: "dim" }, "$ "), cur));
  f.term.scrollTop = f.term.scrollHeight; f.dot.classList.remove("live");
}
Promise.resolve(JSON.parse(document.getElementById("nqdemos").textContent)).then((D) => {
  const sections = [...document.querySelectorAll(".section")];
  const linesOf = (s) => (D[s.dataset.demo] || []).flatMap((l) => l.split("\n"));
  const stage = makeFig(); $("#stagefig").append(stage.bar, stage.frame, stage.cap);
  const copy = $(".copy"); copy.classList.add("synced");
  let current = null, token = { stop: true };
  function show(sec) {
    if (sec === current) return;
    current = sec; token.stop = true; const t = token = { stop: false };
    for (const s of sections) s.classList.toggle("is-active", s === sec);
    stage.cap.classList.remove("is-visible");
    stage.frame.classList.add("is-swapping");
    setTimeout(() => {
      if (t.stop) return;
      stage.title.textContent = sec.dataset.title; stage.cap.textContent = sec.dataset.cap;
      const lines = linesOf(sec); fit(stage, lines);
      stage.frame.classList.remove("is-swapping"); stage.cap.classList.add("is-visible");
      play(stage, lines, t);
    }, current ? 220 : 0);
  }
  function active() {
    const fr = stage.frame.getBoundingClientRect();
    const line = fr.top + fr.height * 0.7;
    let act = null, firstVisible = null;
    for (const s of sections) {
      const r = s.getBoundingClientRect();
      if (r.bottom > 0 && r.top < innerHeight && !firstVisible) firstVisible = s;
      const t = $(".section-title", s).getBoundingClientRect();
      if (t.top + t.height * 0.5 <= line) { act = s; continue; }
      if (act) break;
    }
    return act || firstVisible || sections[0];
  }
  let raf = 0;
  const update = () => { raf = 0; if (!narrow.matches) show(active()); };
  addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
  addEventListener("resize", () => { if (current && !narrow.matches) fit(stage, linesOf(current)); update(); });
  /* narrow screens: one terminal inside each section, played when it scrolls in */
  for (const s of sections) {
    const f = makeFig(); f.title.textContent = s.dataset.title; f.cap.textContent = s.dataset.cap;
    $(".slot", s).append(el("figure", { class: "fig" }, f.bar, f.frame, f.cap));
    let ran = false;
    new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting && narrow.matches && !ran) { ran = true; const l = linesOf(s); fit(f, l); play(f, l, { stop: false }); } }, { threshold: 0.18 }).observe(f.frame);
  }
  update();
});

/* hero logo intro (after pi.dev's 18 fps bevelled-block intro): the hexagon's six facets
   drop in one at a time, lock, flash, and hand over to the real logo */
(function () {
  const cv = $("#logocv"), stage = cv && cv.parentElement;
  if (!cv || !cv.getContext || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const g = cv.getContext("2d"), W = cv.width, H = cv.height, cx = W / 2, cy = H / 2, R = 150;
  const FPS = 30, STEP = 1000 / FPS, GRID = 14;
  const cols = ["#00d8cf", "#2fb3e0", "#6a7ff0", "#a85ae6", "#d93fc2", "#ff2fae"];
  const corner = (k) => [cx + R * Math.cos((Math.PI / 3) * k - Math.PI / 2), cy + R * Math.sin((Math.PI / 3) * k - Math.PI / 2)];
  const facets = [0, 1, 2, 3, 4, 5].map((k) => [[cx, cy], corner(k), corner(k + 1)]);
  const order = [3, 2, 4, 1, 5, 0];            /* bottom first, like a stack settling */
  const shade = (hex, f) => { const n = parseInt(hex.slice(1), 16), c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => Math.round(f > 0 ? v + (255 - v) * f : v * (1 + f))); return `rgb(${c})`; };
  function tri(pts, dy, color, alpha) {
    const p = pts.map(([x, y]) => [x, y + dy]);
    g.globalAlpha = alpha;
    g.beginPath(); g.moveTo(...p[0]); g.lineTo(...p[1]); g.lineTo(...p[2]); g.closePath();
    g.fillStyle = color; g.fill();
    /* bevel: light on edges that face up, dark on edges that face down */
    for (let i = 0; i < 3; i++) {
      const a = p[i], b = p[(i + 1) % 3], ny = (b[0] - a[0]);
      g.beginPath(); g.moveTo(...a); g.lineTo(...b);
      g.strokeStyle = ny > 0 ? "rgba(255,255,255,.55)" : "rgba(0,0,0,.45)"; g.lineWidth = ny > 0 ? 5 : 6; g.stroke();
    }
    const m = [(p[0][0] + p[1][0] + p[2][0]) / 3, (p[0][1] + p[1][1] + p[2][1]) / 3];
    g.beginPath(); p.forEach(([x, y], i) => { const q = [m[0] + (x - m[0]) * 0.72, m[1] + (y - m[1]) * 0.72]; i ? g.lineTo(...q) : g.moveTo(...q); }); g.closePath();
    g.fillStyle = shade(color, 0.12); g.fill();
    g.globalAlpha = 1;
  }
  const drop = 8, hold = 1;                    /* frames per facet fall, frames held after lock */
  const total = order.length * (drop + hold) + 10;
  let frame = 0, last = 0;
  stage.classList.add("playing");
  function draw(t) {
    if (t - last < STEP) { requestAnimationFrame(draw); return; }
    last = t; frame++;
    g.clearRect(0, 0, W, H);
    order.forEach((k, i) => {
      const start = i * (drop + hold), f = frame - start;
      if (f < 0) return;
      const fall = Math.max(0, drop - f) / drop;
      const dy = -Math.round((fall * fall * (H + R)) / GRID) * GRID;   /* stepped, gravity-like */
      tri(facets[k], dy, cols[k], 1);
    });
    const end = order.length * (drop + hold);
    if (frame > end && frame < end + 7 && (frame - end) % 3 < 1) {   /* lock flash */
      g.globalAlpha = 0.55; g.fillStyle = "#ffffff";
      g.beginPath(); for (let k = 0; k < 6; k++) { const c = corner(k); k ? g.lineTo(...c) : g.moveTo(...c); } g.closePath(); g.fill(); g.globalAlpha = 1;
    }
    if (frame >= total) { stage.classList.remove("playing"); return; }
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();
</script>
</body>
</html>
