# Maintainer: Vansh Singh Ruhela <vsruhela@proton.me>
pkgname=noqtis
pkgver=0.1.4
pkgrel=1
pkgdesc='Post-quantum signing, KEMs and sealed input records in C11'
arch=('x86_64' 'aarch64' 'i686' 'armv7h')
url='https://github.com/rootcoder007/noqtis'
license=('Apache-2.0 WITH LLVM-exception')
depends=('glibc')
makedepends=('cmake')
source=("https://github.com/rootcoder007/noqtis/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('5947768511c94b369d76e416c09de6af5eabc013c04020a2e198c1e9701064b2')

build() {
  cmake -S "$pkgname-$pkgver" -B build -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr -DNQSHARED=ON -DNQWERROR=OFF
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver"/{LICENSE,NOTICE} \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
