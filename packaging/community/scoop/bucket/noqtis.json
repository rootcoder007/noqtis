                "extract_dir": "noqtis-$version-windows-x86_64"
            },
            "arm64": {
                "url": "https://github.com/rootcoder007/noqtis/releases/download/v$version/noqtis-$version-windows-arm64.zip",
                "extract_dir": "noqtis-$version-windows-arm64"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
