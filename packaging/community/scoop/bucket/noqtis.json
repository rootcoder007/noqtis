    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rootcoder007/noqtis/releases/download/v0.0.0/noqtis-0.0.0-windows-x86_64.zip",
            "hash": "FILL_WIN64_SHA256",
            "extract_dir": "noqtis-0.0.0-windows-x86_64"
        },
        "arm64": {
            "url": "https://github.com/rootcoder007/noqtis/releases/download/v0.0.0/noqtis-0.0.0-windows-arm64.zip",
            "hash": "FILL_ARM64_SHA256",
            "extract_dir": "noqtis-0.0.0-windows-arm64"
        }
    },
    "bin": "bin\\noqtis.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
